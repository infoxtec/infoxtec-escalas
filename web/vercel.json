{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": true },
  "installCommand": "echo sem dependencias: a Vercel so redireciona",
  "buildCommand": "mkdir -p dist && printf '<!doctype html><title>Trilha</title>' > dist/index.html",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/:path*", "destination": "https://trilha.david-cerqueira.workers.dev/:path*", "permanent": true }
  ]
}
