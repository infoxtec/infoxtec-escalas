// Painel da PRODUÇÃO no Cloudflare (A3, decisão 133): igual a ../wrangler.producao.jsonc, com o caminho a partir de web/.
// Build: npm run build:producao; deploy: npx --yes wrangler@4.151.3 deploy --config wrangler.producao.jsonc
{
  "name": "trilha",
  "compatibility_date": "2026-10-01",
  // endereço oficial em workers.dev ligado; URLs de pré-visualização por versão desligadas (só o endereço exato, A1)
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
