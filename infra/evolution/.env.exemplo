# Copie para .env (cp .env.exemplo .env) e preencha. O .env NUNCA vai para o Git.
# Gere os valores aleatórios com:  openssl rand -hex 32

# Endereço do servidor. Sem DNS próprio: IP com traços + .sslip.io (ex.: IP 150.230.10.25 ->
# 150-230-10-25.sslip.io), que aponta sozinho para o IP e permite HTTPS. Com DNS próprio no futuro:
# whatsapp.infoxtec.com.br (trocar aqui, docker compose up -d, e o evolution_url no sistema).
DOMINIO=150-230-10-25.sslip.io

# Mesma versão da Evolution que está em uso hoje (conferir no Manager atual); não use "latest"
EVOLUTION_IMAGEM=evoapicloud/evolution-api:v2.3.7

# Chave-mestra da API: é a que o sistema guarda no Vault como EVOLUTION_API_KEY.
# Para trocar: edite aqui, rode "docker compose up -d" e o script scripts/rotacionar-evolution.sh.
AUTHENTICATION_API_KEY=

# Senha do Postgres interno da Evolution (não é o banco do sistema)
POSTGRES_SENHA=

# Contorno do defeito de pareamento da v2.3.7 (issue #2437 da Evolution). Sem isto o celular
# responde "não foi possível conectar". Conectar pelo QR Code; o código de pareamento falha nessa versão.
CONFIG_SESSION_PHONE_VERSION=2.3000.1033773198
