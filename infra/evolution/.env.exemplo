# Copie para .env (cp .env.exemplo .env) e preencha. O .env NUNCA vai para o Git.
# Gere os valores aleatórios com:  openssl rand -hex 32

# Subdomínio apontado para o IP do servidor (registro A no DNS)
DOMINIO=whatsapp.infoxtec.com.br

# Mesma versão da Evolution que está em uso hoje (conferir no Manager atual); não use "latest"
EVOLUTION_IMAGEM=evoapicloud/evolution-api:v2.3.7

# Chave-mestra da API: é a que o sistema guarda no Vault como EVOLUTION_API_KEY.
# Para trocar: edite aqui, rode "docker compose up -d" e o script scripts/rotacionar-evolution.sh.
AUTHENTICATION_API_KEY=

# Senha do Postgres interno da Evolution (não é o banco do sistema)
POSTGRES_SENHA=
